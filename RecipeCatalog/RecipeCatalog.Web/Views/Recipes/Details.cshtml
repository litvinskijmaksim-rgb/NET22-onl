@model RecipeCatalog.Data.Entities.Recipe

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    
    <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>
    
    
    <div class="mb-4">
        <span class="badge bg-primary">📂 @Model.Category?.Name</span>
        <span class="badge bg-secondary">⏱️ @Model.CookingTimeMinutes мин</span>
        <span class="badge bg-warning text-dark">⭐ @Model.AverageRating.ToString("0.0")</span>
    </div>
    
    <hr />
    
    
    <div class="mb-4">
        <h3>📖 Описание</h3>
        <p class="lead">@Model.Description</p>
    </div>
    
    
    <div class="mb-4">
        <h3>🛒 Ингредиенты</h3>
        @if (Model.RecipeIngredients != null && Model.RecipeIngredients.Any())
        {
            <ul>
                @foreach (var ri in Model.RecipeIngredients)
                {
                    <li>@ri.Ingredient?.Name - @ri.Quantity @ri.Ingredient?.Unit</li>
                }
            </ul>
        }
        else
        {
            <p>Ингредиенты не указаны</p>
        }
    </div>
    
   
    <div class="mb-4">
        <h3>👨‍🍳 Способ приготовления</h3>
        <div style="white-space: pre-line;">@Model.Instructions</div>
    </div>
    
    
    <a asp-action="Index" class="btn btn-secondary">← Назад к рецептам</a>
</div>