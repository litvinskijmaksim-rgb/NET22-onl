@model Product

<h2>Изменить товар: @Model.Name</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id">

    <p>Название: <br /><input type="text" name="Name" value="@Model.Name" required style="width:300px; padding:5px;"></p>
    <p>Категория: <br /><input type="text" name="Category" value="@Model.Category" required style="width:300px; padding:5px;"></p>
    <p>Цена: <br /><input type="number" step="0.01" name="Price" value="@Model.Price" required style="width:300px; padding:5px;"></p>
    <p>Количество: <br /><input type="number" name="Quantity" value="@Model.Quantity" required style="width:300px; padding:5px;"></p>

    <p>
        <button type="submit" style="background:blue; color:white; padding:10px 20px; border:none;">
            Сохранить изменения
        </button>
        <a href="/Product" style="background:gray; color:white; padding:10px 20px; text-decoration:none; margin-left:10px;">
            Отмена
        </a>
    </p>
</form>