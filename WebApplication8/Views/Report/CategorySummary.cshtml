@model Dictionary<string, decimal>

<h2>Сумма по категориям</h2>

@if (Model.Count > 0)
{
    <table border="1" cellpadding="10" width="100%">
        <tr style="background-color:#f2f2f2">
            <th>Категория</th>
            <th>Общая стоимость</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Key</td>
                <td><b>@item.Value руб.</b></td>
            </tr>
        }

       
        @{
            var total = Model.Values.Sum();
        }
        <tr style="background-color:#e8f4f8">
            <td><b>ВСЕГО:</b></td>
            <td><b style="color:red;">@total руб.</b></td>
        </tr>
    </table>
}
else
{
    <p>Нет данных</p>
}

<p style="margin-top:30px;">
    <a href="/Product" style="background:gray; color:white; padding:10px; text-decoration:none;">
        Назад к товарам
    </a>
    <a href="/Report/TotalValue" style="background:green; color:white; padding:10px; text-decoration:none; margin-left:10px;">
        Общая стоимость
    </a>
</p>